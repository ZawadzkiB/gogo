{
  "description": "gogo — config reminder on session start; user-gate ping on notifications (blocking prompts always; agent_completed and unknown types only when a .gogo work item newly arrives at a gate).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/config-check.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/notify.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
