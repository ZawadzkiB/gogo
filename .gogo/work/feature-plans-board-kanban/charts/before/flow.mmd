flowchart TD
  subgraph TUI["plans tab TODAY - grouped list (cli/internal/tui/plans_tab.go)"]
    L["viewPlans: ACTIVE / READY / DRAFTS stacked sections<br/>+ a single flat planIdx cursor (no columns)"]
    R{"r - planReadyAndSpawn (OVERLOADED)"}
    D["D - planAcceptUAT"]
  end
  L --> R
  R -->|targetless plan| MR["MarkReady only"]
  R -->|has targets| SPAWN["mark ready AND auto-spawn<br/>a work item per un-spawned target"]
  SPAWN --> LP["launch /gogo:plan --correlation plan-XXXX (per target)"]
  SPAWN --> REC["record member + SetStatus active"]
  LP --> SK["gogo:plan skill writes source .gogo/work/"]

  L --> D
  D --> MSHIP{"every member shipped?"}
  MSHIP -->|yes| DONE["MarkDone: append Project UAT round + flip done<br/>(no archive, no changelog)"]
  MSHIP -->|no| REFUSE["refuse - name unshipped"]

  classDef hot fill:#ffe0e0,stroke:#d97c7c,color:#111
  class R,SPAWN hot
